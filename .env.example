# Copy to .env.local for local development, or set these in Vercel.

# --- client (build time, baked into the bundle — never put secrets here) ---
# Leave unset to use the built-in mock extractor.
# Set to /api/extract to use the Gemini backend in api/extract.ts.
VITE_EXTRACT_ENDPOINT=/api/extract

# --- server (runtime, stays on the server) ---
# Free key, no credit card: https://aistudio.google.com/apikey
# Also accepted, in this order: API_KEY_LIFEDROP, GOOGLE_API_KEY, GEMINI_KEY
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
