# Copy to .env.local for local development, or set these in Vercel.

# --- client (build time, baked into the bundle — never put secrets here) ---
# Leave unset to use the built-in mock extractor.
# Set to /api/extract to use the Gemini backend in api/extract.ts.
VITE_EXTRACT_ENDPOINT=/api/extract

# --- server (runtime, stays on the server) ---
# Free key, no credit card: https://aistudio.google.com/apikey
# Also accepted, in this order: API_KEY_LIFEDROP, GOOGLE_API_KEY, GEMINI_KEY
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash

# --- cloud accounts (optional) ---
# Leave both unset and LifeDrop stays device-only, with no sign-in offered.
# From your Supabase project: Settings -> API.
# The anon key is public by design and ships in the bundle. What protects each
# user's vault is the row-level security in supabase/schema.sql — run it first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. NEVER give this a VITE_ prefix — it would end up in the bundle
# and hand every visitor full access to the database, bypassing row-level
# security. Supabase -> Settings -> API Keys -> Secret keys.
# Used by api/signup.ts to create username accounts already confirmed, so the
# project's "Confirm email" setting cannot break sign-up.
SUPABASE_SECRET_KEY=
